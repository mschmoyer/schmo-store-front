###############################################################################
# RebelShops — environment variables
#
# Every variable below is one the code actually reads (grep `process.env.`).
# Copy to .env.local for development:  cp .env.example .env.local
#
# Legend
#   [required]        the app is broken without it
#   [optional]        has a working default
#   [build]           must exist during `next build` / the Vercel build step
#   [runtime]         read when a request or job is served
#   [vercel-provided] injected automatically by Vercel — do NOT set by hand
#   [public]          NEXT_PUBLIC_* is inlined into the browser bundle.
#                     Never put a secret behind a NEXT_PUBLIC_ name.
###############################################################################


#==============================================================================
# Database — connection
#==============================================================================

# [required] [build] [runtime]
# Primary connection string.
#
# On Vercel this must be the Neon **pooled** endpoint (host contains "-pooler"):
# serverless functions open and drop connections constantly and the pooler is
# what absorbs that.
#
#   local  postgresql://postgres:postgres@127.0.0.1:5432/rebelshops
#   Neon   postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/rebelshops?sslmode=require
#
# TLS is decided by the hostname: anything that is not loopback gets TLS
# automatically. There is no DB_SSL flag any more.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rebelshops

# [optional] [build]
# Direct (non-pooled) Neon endpoint — the same host **without** "-pooler".
# Migrations use this: PgBouncer runs in transaction pooling mode, which breaks
# the session advisory lock that stops two concurrent deploys racing.
# The Vercel/Neon integration also sets DATABASE_URL_UNPOOLED and
# POSTGRES_URL_NON_POOLING; either is picked up automatically.
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/rebelshops?sslmode=require

# [optional] [runtime]
# Forces the Neon serverless driver regardless of hostname. Normally unused —
# the driver is detected from the host in DATABASE_URL.
# NEON_DATABASE_URL=

# [optional] [runtime]
# Escape hatch for driver selection: "neon" or "pg". Leave unset to auto-detect.
# DB_DRIVER=

# [optional] [runtime] Pool tuning. Defaults: 5 on Neon, 20 on plain Postgres.
# DB_POOL_SIZE=5
# DB_CONNECTION_TIMEOUT=10000
# DB_IDLE_TIMEOUT=10000

# [optional] [runtime]
# Set to "false" only for a remote database with a self-signed certificate.
# Neon presents a publicly trusted certificate, so leave this alone.
# DB_SSL_REJECT_UNAUTHORIZED=true

# [optional] Legacy discrete connection parameters. Used only when no
# connection string above is set. Prefer DATABASE_URL.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=rebelshops
# DB_USER=postgres
# DB_PASSWORD=postgres


#==============================================================================
# Database — migration runner (database/migrate.js)
#==============================================================================

# [optional] How long to wait for the advisory lock before giving up. Default
# 120000. Raise it if two deploys routinely overlap.
# MIGRATION_LOCK_TIMEOUT_MS=120000

# [optional] Allow migrating through a "-pooler" host. The runner refuses by
# default because session advisory locks are unreliable through PgBouncer.
# ALLOW_POOLED_MIGRATIONS=false

# [optional] Required to run `--reset` against a non-local database. Guardrail
# against dropping every table in production.
# ALLOW_DESTRUCTIVE_RESET=false


#==============================================================================
# Application URLs
#==============================================================================

# [required] [runtime]
# Absolute origin of this deployment. Used for canonical URLs, OG tags, Stripe
# redirect URLs, and by the sync job when it calls back into its own API.
#   local       http://localhost:3000
#   production  https://rebelshops.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [optional] [runtime] [public]
# Legacy alias still read in a few places. Set it to the same value as
# NEXT_PUBLIC_APP_URL. The cron jobs prefer this when resolving their own host.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# [optional] [build]
# Host that production traffic is canonicalised to by next.config.ts. Defaults
# to rebelshops.com. Only takes effect when VERCEL_ENV === "production".
# NEXT_PUBLIC_CANONICAL_HOST=rebelshops.com


#==============================================================================
# Authentication
#==============================================================================

# [required] [runtime]
# HS256 signing key for session JWTs. Generate with:  openssl rand -base64 48
# A different value per environment invalidates that environment's sessions.
JWT_SECRET=change-me-in-every-environment

# [optional] [runtime] bcrypt work factor for password hashing. Default 12.
# BCRYPT_ROUNDS=12


#==============================================================================
# Scheduled jobs (Vercel Cron)
#==============================================================================

# [required in production] [runtime]
# Vercel Cron sends this as `Authorization: Bearer <value>` on every scheduled
# invocation of /api/cron/*. Without it those routes return 503 and refuse to
# run — they never default open. Generate with:  openssl rand -hex 32
CRON_SECRET=

# [required in production] [runtime]
# Credential the sync job presents when calling back into /api/admin/sync/*.
# Those routes authenticate with `requireAuth`, so this must be a valid,
# long-lived session JWT for a store admin — not a random string. Also accepted
# as a fallback bearer by the /api/cron/* routes.
SYNC_AUTH_TOKEN=


#==============================================================================
# ShipStation
#==============================================================================

# [required wherever ShipStation credentials are read] [runtime]
# 32-byte AES-256-GCM data-encryption key for the per-store ShipStation
# credentials in store_integrations. Base64 or hex.
#
# This is the one integration variable that does NOT degrade gracefully: it
# fails closed. Without it every credential read throws ShipStationKeyError,
# including the legacy-base64 branch, so ShipStation looks connected in the
# admin UI while every sync writes nothing. It was missing from production
# once; that is what it looked like.
#
#   openssl rand -base64 32
SHIPSTATION_ENCRYPTION_KEY=

# [optional] [runtime]
# Fallback API key for /api/products/[productId]. Per-store keys are normally
# read from the store_integrations table instead.
# SHIPSTATION_API_KEY=

# [optional] [runtime] Default ship-from warehouse id used when transforming
# orders that do not specify one.
# SHIPSTATION_WAREHOUSE_ID=


#==============================================================================
# Stripe
#==============================================================================

# [required for checkout] [runtime]
STRIPE_SECRET_KEY=

# [required for checkout] [runtime] [public]
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# [required for webhooks] [runtime]
# Signing secret for the Stripe webhook endpoint. Different per environment —
# use the value Stripe shows for that specific endpoint.
STRIPE_WEBHOOK_SECRET=

# [optional] [runtime] Platform subscription product/price and Connect fee.
# STRIPE_PLATFORM_PRODUCT_ID=
# STRIPE_PLATFORM_PRICE_ID=
# STRIPE_APPLICATION_FEE_BPS=
# STRIPE_INTRO_COUPON_ID=


#==============================================================================
# OpenAI
#==============================================================================

# [required for /api/admin/ai/*] [runtime]
# Blog post, store detail and HS code generators.
OPENAI_API_KEY=


#==============================================================================
# Feature flags and build behaviour
#==============================================================================

# [optional] [runtime] Enables analytics event capture outside production.
# ENABLE_ANALYTICS=false

# [optional] [build]
# The Content-Security-Policy in next.config.ts ships as Report-Only. Set to
# "true" to enforce it, once the browser console is free of violations.
# CSP_ENFORCE=false

# [optional] [build] Set automatically by Next.js and by CI. Do not set by hand.
# NODE_ENV=development


#==============================================================================
# Vercel-provided — never set these yourself
#==============================================================================
# The app reads these; Vercel injects them into every build and invocation.
#
#   VERCEL_ENV                      "production" | "preview" | "development"
#   VERCEL_URL                      per-deployment hostname
#   VERCEL_PROJECT_PRODUCTION_URL   stable production hostname
#   VERCEL_REGION                   region the function ran in
#   VERCEL_GIT_COMMIT_SHA           deployed commit, surfaced by /api/health
#   VERCEL_GIT_COMMIT_REF           deployed branch
#   VERCEL_DEPLOYMENT_ID            deployment identifier
#
# Locally these are all absent, and every consumer has a sensible fallback.
###############################################################################
