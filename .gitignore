# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# development server logs
dev.log

# env files (can opt-in for committing if needed)
.env*
# ...but the template of variable NAMES is documentation, not secrets, and must ship.
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# local documentation
/docs/local

#playwright
/playwright-report
/test-results
.scratch/

# vercel — local project link (project/org ids), not shared state
.vercel

# Ad-hoc screenshot drivers used while building /platform. Scratch, never committed.
.platform-shot*.cjs

# Stripe CLI webhook listener output (docs/payments.md §6)
stripe-listen.log
