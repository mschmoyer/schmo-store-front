{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",

  "buildCommand": "node database/migrate.js && npm run build",
  "installCommand": "npm ci",

  "regions": ["iad1"],

  "functions": {
    "src/app/api/cron/**/route.ts": {
      "maxDuration": 300,
      "memory": 1769
    },
    "src/app/api/admin/sync/**/route.ts": {
      "maxDuration": 300,
      "memory": 1769
    },
    "src/app/api/admin/ai/**/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "src/app/api/admin/purchase-orders/**/pdf/route.ts": {
      "maxDuration": 60,
      "memory": 1769
    },
    "src/app/api/admin/inventory/export/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "src/app/api/admin/inventory/reports/**/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/admin/analytics/**/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/shipstation/webhook/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },

  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/inventory-snapshot",
      "schedule": "10 7 * * *"
    }
  ],

  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|avif|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff|woff2|ttf|otf|eot)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/cron/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],

  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
